# Identity lives in config.local (per machine, not in the repo)
[include]
	path = config.local

[user]
	useConfigOnly = true	# refuse to commit until config.local sets an identity

[alias]
        st = status
        b  = branch
        ci = commit -a
        co = checkout
        prom = pull --rebase origin master
        promain = pull --rebase origin main
        lol = log --graph --decorate --pretty=oneline --abbrev-commit
        hist = log --pretty=format:'%C(yellow)%h%C(reset) %ad | %C(75)%s%C(reset) %C(yellow)%d%C(reset) [%an]' --graph --date=short --branches --all
