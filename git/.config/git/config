# Identity and per-machine overrides live in config.local (not in the repo),
# included at the end so it wins over the settings here

[user]
	useConfigOnly = true	# refuse to commit until config.local sets an identity

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true	# first push of a new branch sets its upstream

[fetch]
	prune = true	# drop remote-tracking branches deleted on the remote

[pull]
	rebase = true	# replay local commits on top instead of a merge commit

[rebase]
	autoStash = true	# stash uncommitted changes around a pull/rebase

[rerere]
	enabled = true	# remember conflict resolutions and reapply them

[diff]
	algorithm = histogram

[merge]
	conflictStyle = zdiff3	# conflict markers also show the original version

[alias]
        st = status
        b  = branch
        ci = commit -a
        co = checkout
        prom = pull --rebase origin master
        promain = pull --rebase origin main
        # pull --rebase the remote's default branch, master or main
        pdef = "!git pull --rebase origin \"$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's@^origin/@@')\""
        lol = log --graph --decorate --pretty=oneline --abbrev-commit
        hist = log --pretty=format:'%C(yellow)%h%C(reset) %ad | %C(75)%s%C(reset) %C(yellow)%d%C(reset) [%an]' --graph --date=short --branches --all

# Last, so this machine's settings override the ones above
[include]
	path = config.local
